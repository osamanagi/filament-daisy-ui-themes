{
    "name": "osamanagi/filament-daisy-ui-themes",
    "description": "Integrating Daisy Ui themes into Filament apps",
    "keywords": [
        "osamanagi",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-daisy-ui-themes"
    ],
    "homepage": "https://github.com/osamanagi/filament-daisy-ui-themes",
    "support": {
        "issues": "https://github.com/osamanagi/filament-daisy-ui-themes/issues",
        "source": "https://github.com/osamanagi/filament-daisy-ui-themes"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "osamanagi",
            "email": "osamanagiworks@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Nagi\\FilamentDaisyUiThemes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nagi\\FilamentDaisyUiThemes\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run",
        "verify": "node bin/verify.mjs"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nagi\\FilamentDaisyUiThemes\\FilamentDaisyUiThemesServiceProvider"
            ],
            "aliases": {
                "FilamentDaisyUiThemes": "Nagi\\FilamentDaisyUiThemes\\Facades\\FilamentDaisyUiThemes"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/vendor",
            "/node_modules",
            "/build",
            "/.agents",
            "/.phpunit.cache",
            "/.env*",
            "/AGENTS.md",
            "/DAISYUI_FILAMENT_PLUGIN_PLAN.md",
            "/package-lock.json",
            "/bin",
            "/.npmrc",
            "/skills-lock.json",
            "/rector.php",
            "/composer.lock"
        ]
    }
}
